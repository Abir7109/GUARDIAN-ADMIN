rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Users: owner-only ──
    match /users/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null
                                   && request.auth.uid == userId;
    }
    // ── Events: user creates own, reads own ──
    match /events/{eventId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    // ── Sessions: user creates own ──
    match /sessions/{sessionId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    // ── App Config: publicly readable ──
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if false;
    }
    // ── Global policy: read-only for app clients.
    //    Readable before sign-in (maintenance / force-update gates run pre-auth).
    //    Holds non-secret app config only (see policies/global).
    //    Writes stay with the Admin SDK / server. ──
    match /policies/{policyId} {
      allow read: if true;
      allow write: if false;
    }
    // ── Everything below: BLOCKED from app clients ──
    // (Admin SDK in the Node.js server bypasses these rules entirely)
    match /admins/{document=**} { allow read, write: if false; }
    match /broadcasts/{document=**} { allow read, write: if false; }
    match /metrics/{document=**} { allow read, write: if false; }
    match /analytics/{document=**} { allow read, write: if false; }
    match /audit_logs/{document=**} { allow read, write: if false; }
    // ── Fallback: deny everything else ──
    match /{document=**} { allow read, write: if false; }
  }
}
